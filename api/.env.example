# Copia este archivo a .env y completa los valores.
# NO uses DATABASE_URL — Rails lo tomaría sobre database.yml y RSpec borraría dev.
# NO subas .env a git. En producción usa .kamal/secrets o vault del host.
# Las credenciales de postgres van aquí; la BD la elige database.yml según RAILS_ENV.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Producción: require (default en database.yml). Dev local sin SSL: DB_SSLMODE=disable
# DB_SSLMODE=require

REDIS_URL=redis://localhost:6379/0
# Producción con TLS: rediss://:password@redis-host:6380/0

DEVISE_JWT_SECRET_KEY=
LOCKBOX_MASTER_KEY=
# Opcional; si vacío usa LOCKBOX_MASTER_KEY (blind_index para búsqueda PII cifrada)
# BLIND_INDEX_MASTER_KEY=
# Solo para el one-shot security:encrypt_contacts con PII legado en claro:
# CONTACT_PII_MIGRATING=true

# Fase 3 — Row Level Security PostgreSQL (default true en production)
# DB_RLS_ENABLED=true

CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000
# Producción (solo https, sin localhost):
# CORS_ALLOWED_ORIGINS=https://crm.iswo.com.co,https://app.crm.iswo.com.co

# Producción — dominio público API (enlaces en correos, Action Mailer)
# APP_HOST=crm.iswo.com.co
# Tras proxy TLS (Kamal / nginx / Cloudflare): ASSUME_SSL=true
# ASSUME_SSL=true

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# true = Claude clasifica temperatura al guardar dossier del lead (oportunidad/contacto)
ANTHROPIC_AUTO_CLASSIFY_TEMPERATURE=true

SPA_HOST=http://localhost:3001

# Checklist Fase 1: bundle exec rails security:infra

# URL base pública de landings (override opcional; default: http://{tenant}.localhost:3001)
# LANDING_PUBLIC_HOST=http://micasita.localhost:3001

POSTMARK_API_TOKEN=
MAIL_FROM=no-reply@crm.iswo.com.co
