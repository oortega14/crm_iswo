# API IGNORES

# Ignore bundler config.
/api/.bundle

# Ignore local env (secrets); versionamos plantillas y .env.test
/api/.env
/api/.env.local
/api/.env.*.local
!/api/.env.example
!/api/.env.test

# Ignore all logfiles and tempfiles.
/api/log/*
/api/tmp/*
!/api/log/.keep
!/api/tmp/.keep

# Ignore pidfiles, but keep the directory.
/api/tmp/pids/*
!/api/tmp/pids/
!/api/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/api/storage/*
!/api/storage/.keep
/api/tmp/storage/*
!/api/tmp/storage/
!/api/tmp/storage/.keep

# Ignore key files for decrypting credentials and more.
/api/config/*.key
/api/config/master.key

# Kamal secrets (never commit)
/api/.kamal/secrets

# Secrets / credenciales (nunca commitear)
/api/rails
/api/credentials

# Cobertura de tests
/api/coverage/

# Exportaciones generadas en runtime
/api/public/exports/

# Claude Code — preferencias locales (máquina / permisos personales)
.claude/settings.local.json

# Secretos raíz (nunca commitear)
/.env
/.env.local
/.env.*
!/.env.example

# CLIENT IGNORES

# Build output
/client/dist/
/client/.tanstack/

# TypeScript build info
/client/tsconfig.tsbuildinfo
/client/tsconfig.node.tsbuildinfo

# Vite build artifacts
/client/vite.config.js
/client/vite.config.d.ts

# Lock file (generado automáticamente)
/client/package-lock.json
