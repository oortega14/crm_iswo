# ============================================================================
# CRM ISWO — variables de entorno de ejemplo
# Copiar a .env y completar. NUNCA commitear .env con valores reales.
#
# IMPORTANTE: crear también .env.test con:
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm_iswo_test
# dotenv-rails carga .env.test antes que .env cuando RAILS_ENV=test,
# evitando que los specs limpien la base de datos de desarrollo.
# ============================================================================

# Base de datos
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm_iswo_development

# Redis (Sidekiq + cache + cable)
REDIS_URL=redis://localhost:6379/0

# Rails
RAILS_LOG_LEVEL=debug

# Secrets — generar con: bin/rails secret
SECRET_KEY_BASE=
DEVISE_JWT_SECRET_KEY=

# Lockbox — generar con: Lockbox.generate_key
LOCKBOX_MASTER_KEY=

# Blind Index — generar con: BlindIndex.generate_key
BLIND_INDEX_MASTER_KEY=

# CORS (orígenes del SPA React separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Email (Postmark)
POSTMARK_API_TOKEN=
MAIL_FROM=no-reply@crm.iswo.com.co

# WhatsApp — Twilio y/o WhatsApp Cloud API (Meta). Integración recomendada: Ajustes → Integraciones.
# WHATSAPP_PROVIDER: twilio | whatsapp_cloud | vacío (auto: si Cloud y Twilio tienen credenciales → Cloud).
# En tenant.settings JSON: whatsapp.provider con el mismo valor para forzar por negocio.
# Sandbox Twilio: el contacto debe unirse al sandbox antes de recibir salientes.
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Cloud API (opcional; también vía integración whatsapp_cloud en CRM)
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=v18.0
WHATSAPP_CLOUD_VERIFY_TOKEN=

# Meta Ads
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=
# OAuth (mismo par que en Google Cloud). Necesario en el API para «Probar conexión» (intercambio refresh → access).
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Clave de seguridad para el webhook de Google (opcional; se envía como ?key=… en la URL).
GOOGLE_ADS_WEBHOOK_KEY=

# Storage (para exportaciones y thumbnails de landing pages)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET=crm-iswo-dev

# Host / subdominios
APP_HOST=crm.iswo.com.co
DEFAULT_TENANT_SLUG=iswo

# Origen público del API (URLs de webhook devueltas en GET /api/v1/ad_integrations → meta).
# Vacío → se usa request.base_url (útil en local). Tras proxy/Ingress, pon https://api.tudominio.com
API_PUBLIC_ORIGIN=http://localhost:3000

# SPA — mismo origen que el frontend Vite (puerto típico 3001). Los correos usan este host para
# /login?tenant=… y /reset-password?token=…&tenant=… (el navegador guarda X-Tenant-Slug).
SPA_HOST=http://localhost:3001

# Claude AI — clasificación inteligente de leads
ANTHROPIC_API_KEY=
